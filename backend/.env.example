# Copy to backend/.env and edit. Never commit the real .env file.

# Local default: SQLite file under ../data (no database server needed).
DATABASE_URL=sqlite:///../data/datarescue.db
# PostgreSQL via Docker Compose (Day 6):
# DATABASE_URL=postgresql+psycopg://datarescue:datarescue@localhost:5432/datarescue

# Random seed for the synthetic dataset. Same seed => same 1,000 transactions.
SEED=42

# Frontend dev-server origins allowed by CORS (Day 4), comma-separated.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional AI investigator (Day 3). Leave blank and the rules-based diagnosis is used,
# clearly labeled method="rules". Set a key to let Claude read incident evidence (read-only).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
